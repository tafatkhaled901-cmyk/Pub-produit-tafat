# Copier ce fichier en .env puis remplir. Ne jamais publier ce fichier rempli.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 1 = mode démonstration : aucun appel payant (script d'exemple, clips fabriqués par FFmpeg).
# Mettre 0 pour utiliser les vraies API ci-dessous.
MOCK_AI=1

# Analyse de la photo et script (console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Clips image→vidéo (fal.ai > API Keys)
FAL_KEY=
VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
VIDEO_IMAGE_PARAM=image_url

PORT=8787
WORKER_CONCURRENCY=2
